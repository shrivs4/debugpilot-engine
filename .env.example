# Copy to .env and adjust. Never commit .env.

# --- Ollama (runs on the host, outside Docker) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5-coder:7b

# --- PostgreSQL (local demo credentials only) ---
POSTGRES_USER=debugpilot
POSTGRES_PASSWORD=debugpilot
POSTGRES_DB=debugpilot

# --- Host ports (all bound to 127.0.0.1) ---
# 5433 avoids clashing with a Postgres already running on the Mac at 5432.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# --- Limits ---
MAX_FILE_SIZE_BYTES=200000
SETUP_COMMAND_TIMEOUT_SECONDS=900
ANALYSIS_COMMAND_TIMEOUT_SECONDS=180

# Also write each run's context package to /workspace/exports as JSON (debugging aid).
EXPORT_DEBUG_JSON=false
